<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CÀI ĐẶT &amp; HỆ THỐNG"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0A5C36"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"/>

        <!-- Card thông tin cá nhân -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thông tin tài khoản"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#0A5C36"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvUserFullName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Họ tên: --"
                android:textSize="14sp"
                android:textColor="#212121"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên đăng nhập: --"
                android:textSize="14sp"
                android:textColor="#212121"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvUserRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quyền hạn: --"
                android:textSize="14sp"
                android:textColor="#0A5C36"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Card Chế độ Tối (Dark Mode) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chế độ tối (Dark Mode)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212121"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swDarkMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"/>
        </LinearLayout>

        <!-- Card Quản lý danh mục & Xuất CSV -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnManageCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quản Lý Danh Mục Thu / Chi"
                android:backgroundTint="#0A5C36"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnExportCsv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Xuất Báo Cáo Thu Chi Ra CSV"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đăng Xuất Tài Khoản"
                android:backgroundTint="#FFEBEE"
                android:textColor="#C62828"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="12dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>